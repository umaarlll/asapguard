# local: read one Azure export file or a directory of JSON files
TELEMETRY_SOURCE=local
LOCAL_TELEMETRY_PATH=../data/raw/azure-export-2026-07-20

# azure: use DefaultAzureCredential (Azure CLI locally, managed identity in Azure)
# TELEMETRY_SOURCE=azure
# AZURE_STORAGE_ACCOUNT=your-storage-account-name
# AZURE_STORAGE_CONTAINER=telemetry
# STORAGE_BLOB_PREFIX=optional/path/prefix
# MAX_AZURE_BLOBS=1500

PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CACHE_SECONDS=15
MAX_HISTORY_MINUTES=1440
STALE_AFTER_SECONDS=180
